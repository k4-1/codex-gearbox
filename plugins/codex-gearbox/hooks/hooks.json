{
  "description": "Codex Gearbox desktop advisor",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'for bin in \"$HOME/.local/bin/shift\" \"$HOME/.cargo/bin/shift\"; do if [ -x \"$bin\" ]; then exec \"$bin\" hook; fi; done; exit 127'",
            "commandWindows": "cmd.exe /d /c \"%USERPROFILE%\\.local\\bin\\shift.exe hook\"",
            "timeout": 20,
            "statusMessage": "Selecting a Codex gear"
          }
        ]
      }
    ]
  }
}
